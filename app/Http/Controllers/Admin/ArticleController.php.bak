<?php

// Update app/Http/Controllers/Admin/ArticleController.php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\Article;
use Illuminate\Http\Request;
use Illuminate\Support\Str;
use Illuminate\Support\Facades\Storage;

class ArticleController extends Controller
{
    public function index()
    {
        $articles = Article::orderBy('created_at', 'desc')->paginate(10);
        return view('admin.articles.index', compact('articles'));
    }

    public function create()
    {
        return view('admin.articles.create');
    }

public function store(Request $request)
{
    // Validasi input
    $validated = $request->validate([
        'title' => 'required|max:255',
        'excerpt' => 'required',
        'category' => 'required',
        'tags' => 'nullable|string',
        'featured_image' => 'nullable|image|max:2048',
        'is_published' => 'nullable|boolean',
        'article_steps' => 'nullable|string' // Ganti dari 'json' ke 'string' karena kita akan memprosesnya secara manual
    ]);

    // Handle is_published checkbox
    $validated['is_published'] = $request->has('is_published');

    // Handle featured image upload
    if ($request->hasFile('featured_image')) {
        $validated['featured_image'] = $request->file('featured_image')->store('articles', 'public');
    }

    // Process steps data from JSON string
    $steps = json_decode($validated['article_steps'] ?? '[]', true);
    $processedSteps = [];
    
    foreach ($steps as $index => $step) {
        $stepData = [
            'step_number' => $step['step_number'] ?? ($index + 1),
            'title' => $step['title'] ?? '',
            'explanation' => $step['explanation'] ?? '',
            'code' => $step['code'] ?? '',
            'code_language' => $step['code_language'] ?? 'php',
            'image_alt' => $step['image_alt'] ?? '',
            'image_path' => null // Default value
        ];

        // Handle step image upload
        $imageName = "step_image_" . ($index + 1);
        if ($request->hasFile($imageName)) {
            $imagePath = $request->file($imageName)->store('article_steps', 'public');
            $stepData['image_path'] = $imagePath;
        }
        
        $processedSteps[] = $stepData;
    }

    // Generate content from steps for backward compatibility (Opsional, tapi bagus untuk SEO)
    $content = $this->generateContentFromSteps($processedSteps);

    // Prepare the rest of the data
    $validated['slug'] = Str::slug($validated['title']);
    $validated['content'] = $content;
    $validated['tags'] = $validated['tags'] ? array_map('trim', explode(',', $validated['tags'])) : null;
    $validated['article_steps'] = $processedSteps;

    if ($validated['is_published']) {
        $validated['published_at'] = now();
    }

    // Unset the JSON field from validation to prevent mass assignment error
    unset($validated['article_steps']);

    // Create the article instance
    $article = Article::create($validated);

    // After creating, update the steps with the processed data.
    $article->update(['article_steps' => $processedSteps]);

    // Return JSON response for AJAX
    return response()->json([
        'success' => true,
        'message' => 'Artikel berhasil dibuat!',
        'redirect_url' => route('admin.articles.index')
    ]);
}
    public function destroy(Article $article)
    {
        // Delete featured image
        if ($article->featured_image) {
            Storage::disk('public')->delete($article->featured_image);
        }

        $article->delete();
        return redirect()->route('admin.articles.index')
            ->with('success', 'Artikel berhasil dihapus!');
    }

    /**
     * Generate readable content from steps array
     */
    private function generateContentFromSteps($steps)
    {
        if (empty($steps)) return '';

        $content = '';
        foreach ($steps as $step) {
            if (empty($step['title']) && empty($step['explanation'])) continue;
            
            // Add step title as heading
            if (!empty($step['title'])) {
                $stepNumber = $step['step_number'] ?? '';
                $content .= "## {$stepNumber}. " . $step['title'] . "\n\n";
            }
            
            // Add explanation
            if (!empty($step['explanation'])) {
                $content .= $step['explanation'] . "\n\n";
            }
            
            // Add code block if exists
            if (!empty($step['code'])) {
                $language = $step['code_language'] ?? 'php';
                $content .= "```{$language}\n" . $step['code'] . "\n```\n\n";
            }
            
            // Add image placeholder if exists
            if (!empty($step['image_alt'])) {
                $content .= "*[Screenshot: " . $step['image_alt'] . "]*\n\n";
            }
            if (!empty($step['image_path'])) {
                $content .= "![".$step['image_alt']."](".asset('storage/'.$step['image_path']).")\n\n";
            }
        }

        return $content;
    }
}
